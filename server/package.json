{
  "name": "fresh-portal-r1-server",
  "version": "0.1.0-pilot",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --transpile-only --respawn src/index.ts",
    "start": "node dist/src/index.js",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:org-scope": "jest --runInBand --detectOpenHandles --testMatch '**/test/canonicalOrg.scope.ts'"
  },
  "dependencies": {
    "argon2": "0.41.1",
    "busboy": "1.6.0",
    "cookie": "0.7.1",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "fflate": "0.8.3",
    "pg": "8.13.1",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cookie": "0.6.0",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.14.15",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
