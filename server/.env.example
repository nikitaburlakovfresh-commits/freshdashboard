# Fresh Portal R1 — example environment. No secrets committed.
# Copy to .env and fill in real values for local/dev use only.

NODE_ENV=development
PORT=4000

# PostgreSQL 16 connection. In docker-compose this hostname is "db".
PGHOST=localhost
PGPORT=5432
PGDATABASE=fresh_pilot
PGUSER=fresh_app
# PGPASSWORD must be supplied via environment / secret store, never committed.
PGPASSWORD=

# Session / CSRF secrets. Generate distinct random 32+ byte values per environment.
SESSION_HMAC_SECRET=
CSRF_HMAC_SECRET=

# Exact allowed Origin for CSRF/Origin checks (no wildcard).
ALLOWED_ORIGIN=http://localhost:5173

# Seed script fixture password (test/dev only). Never set in a shared/prod env.
# If unset, db:seed refuses to run outside NODE_ENV=test|development.
SEED_FIXTURE_PASSWORD=
